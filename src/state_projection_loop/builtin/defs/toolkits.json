  {
    "name": "find",
    "category": "filesystem",
    "spec": {
      "description": "Find files recursively under a workspace directory, optionally filtering by glob. Returns up to max_results workspace-relative paths.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "default": "",
            "description": "Workspace-relative directory; empty for the workspace root."
          },
          "pattern": {
            "type": "string",
            "default": "*",
            "description": "Glob matching file name or workspace-relative path."
          },
          "max_results": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    "discovery": {
