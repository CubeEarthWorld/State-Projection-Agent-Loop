# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Any OpenAI-compatible API (see OpenAICompatAdapter.from_env in
# examples/llm_adapters.py). DEEPSEEK_API_KEY is read when LLM_API_KEY is unset.
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# Optional: local path to an embeddinggemma-300m GGUF file.
# If unset, integration tests download it from Hugging Face into the HF cache.
SPAL_EMBED_GGUF=

# Set to 1 to enable live integration tests (they cost API credits)
SPAL_RUN_LIVE=
