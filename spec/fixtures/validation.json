{
  "validate_args": [
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        },
        "required": [
          "a"
        ]
      },
      "arguments": {},
      "expected": "arguments: missing required property \"a\""
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        }
      },
      "arguments": {
        "a": 42
      },
      "expected": "arguments.a: expected type \"string\", got integer"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        }
      },
      "arguments": {
        "a": null
      },
      "expected": "arguments.a: expected type \"string\", got null"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "arguments": {
        "a": 1.5
      },
      "expected": "arguments.a: expected type [\"string\",\"null\"], got number"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "enum": [
              "x",
              "y"
            ]
          }
        }
      },
      "arguments": {
        "a": "z"
      },
      "expected": "arguments.a: \"z\" is not one of [\"x\",\"y\"]"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "arguments": {
        "a": 0
      },
      "expected": "arguments.a: 0 is less than minimum 1"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer",
            "maximum": 9
          }
        }
      },
      "arguments": {
        "a": 10
      },
      "expected": "arguments.a: 10 is greater than maximum 9"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 2
          }
        }
      },
      "arguments": {
        "a": "abc"
      },
      "expected": "arguments.a: longer than maxLength 2"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "arguments": {
        "a": "ok",
        "b": 1,
        "c": 2
      },
      "expected": "arguments: unexpected properties [\"b\",\"c\"]"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "arguments": {
        "a": [
          1,
          "two"
        ]
      },
      "expected": "arguments.a[1]: expected type \"integer\", got string"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "default": "d"
          }
        }
      },
      "arguments": {},
      "expected": null
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "enum": [
              {
                "k": 1
              },
              {
                "k": 2
              }
            ]
          }
        }
      },
      "arguments": {
        "a": {
          "k": 1
        }
      },
      "expected": null
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "enum": [
              {
                "k": 1
              }
            ]
          }
        }
      },
      "arguments": {
        "a": {
          "k": 9
        }
      },
      "expected": "arguments.a: {\"k\":9} is not one of [{\"k\":1}]"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "enum": [
              [
                1,
                2
              ],
              [
                3
              ]
            ]
          }
        }
      },
      "arguments": {
        "a": [
          1,
          2
        ]
      },
      "expected": null
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "enum": [
              [
                1,
                2
              ]
            ]
          }
        }
      },
      "arguments": {
        "a": [
          2,
          1
        ]
      },
      "expected": "arguments.a: [2,1] is not one of [[1,2]]"
    },
    {
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "enum": [
              null,
              "x"
            ]
          }
        }
      },
      "arguments": {
        "a": null
      },
      "expected": null
    }
  ],
